# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# NVIDIA NIM (free key: https://build.nvidia.com)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# One model per agent (each agent file reads its own)
NIM_MODEL_PLANNER=meta/llama-3.3-70b-instruct
NIM_MODEL_SEARCH=meta/llama-3.3-70b-instruct
NIM_MODEL_EXTRACT=meta/llama-3.3-70b-instruct
NIM_MODEL_SYNTHESIZE=meta/llama-3.3-70b-instruct

# Shared cross-process rate limit (requests per minute); keep under the provider's limit
RATE_LIMIT_RPM=30
